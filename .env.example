# Copy to .env (git-ignored) and change the password. Local development values only:
# never put production credentials in this file or in .env.

# ---- Docker Compose: PostgreSQL container ---------------------------------------------
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=datapilot
POSTGRES_TEST_DB=datapilot_test
POSTGRES_PORT=5432

# ---- Backend (app/core/config.py reads DP_* variables) ---------------------------------
DP_ENV=dev
# SQLAlchemy URL. Keep the user/password/port in sync with the values above.
DP_DATABASE_URL=postgresql+psycopg://datapilot:change-me-local-only@localhost:5432/datapilot
# Optional: the URL Alembic migrates with. Defaults to DP_DATABASE_URL. Set it when the API should connect as a
# less-privileged role than the schema owner that runs migrations.
# DP_MIGRATION_DATABASE_URL=postgresql+psycopg://datapilot:change-me-local-only@localhost:5432/datapilot

# Used only by the test suite. The database name must end in "_test"; tests refuse anything else.
DP_TEST_DATABASE_URL=postgresql+psycopg://datapilot:change-me-local-only@localhost:5432/datapilot_test

# Optional tuning (defaults shown).
# DP_DB_MIGRATION_LOCK_TIMEOUT_MS=10000
# DP_DB_POOL_SIZE=5
# DP_DB_MAX_OVERFLOW=10
# DP_DB_POOL_TIMEOUT_SECONDS=10
# DP_DB_POOL_RECYCLE_SECONDS=1800
# DP_DB_CONNECT_TIMEOUT_SECONDS=5
# DP_DB_STATEMENT_TIMEOUT_MS=15000
# DP_DB_ECHO=false
