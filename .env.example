# Copy to .env (git-ignored) and replace both passwords. Local development values only:
# never put production credentials in this file or in .env.

# ---- Docker Compose: PostgreSQL container ---------------------------------------------
# Schema owner: runs migrations and owns every table. The API never connects as this user.
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=change-me-owner-local-only
# Runtime user the API connects as: owns nothing, no DDL, SELECT/INSERT only on audit_events.
POSTGRES_APP_USER=datapilot_app
POSTGRES_APP_PASSWORD=change-me-app-local-only
POSTGRES_DB=datapilot
POSTGRES_TEST_DB=datapilot_test
POSTGRES_PORT=5432

# ---- Backend (app/core/config.py reads DP_* variables) ---------------------------------
DP_ENV=dev
# The API connects as the runtime user...
DP_DATABASE_URL=postgresql+psycopg://datapilot_app:change-me-app-local-only@localhost:5432/datapilot
# ...and Alembic as the owner. Both are required and must be different users.
DP_MIGRATION_DATABASE_URL=postgresql+psycopg://datapilot:change-me-owner-local-only@localhost:5432/datapilot

# Test suite only. Database names must end in "_test"; tests refuse anything else.
DP_TEST_DATABASE_URL=postgresql+psycopg://datapilot_app:change-me-app-local-only@localhost:5432/datapilot_test
DP_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://datapilot:change-me-owner-local-only@localhost:5432/datapilot_test

# ---- Authentication keys (generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
# Keyrings are "<version>=<secret>" lists; the active version signs/hashes, older listed versions still verify, so
# rotate by adding a new version, making it active, and removing the old one once its tokens have expired.
DP_JWT_SIGNING_KEYS=k1=change-me-generate-a-48-character-random-secret-here
DP_JWT_ACTIVE_KID=k1
DP_API_KEY_PEPPERS=p1=change-me-generate-a-48-character-random-secret-here
DP_API_KEY_PEPPER_VERSION=p1

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs/CIDRs). Empty = trust none:
# the client address is always the direct peer. Only list proxies you operate.
# DP_TRUSTED_PROXIES=10.0.0.0/8

# Optional tuning (defaults shown).
# DP_DB_POOL_SIZE=5
# DP_DB_MAX_OVERFLOW=10
# DP_DB_POOL_TIMEOUT_SECONDS=10
# DP_DB_POOL_RECYCLE_SECONDS=1800
# DP_DB_CONNECT_TIMEOUT_SECONDS=5
# DP_DB_STATEMENT_TIMEOUT_MS=15000
# DP_DB_MIGRATION_LOCK_TIMEOUT_MS=10000
# DP_DB_ECHO=false
